# Electron and the local npm launcher create and reuse stable keys in
# %LOCALAPPDATA%\JobSync\config\runtime.json. No .env file is needed for them.
# Configure providers and encrypted API keys in Settings.
# See WINDOWS_DESKTOP.md and WINDOWS_LOCAL.md for development and diagnostics.

# Optional environment-based provider credentials for development only.
# Never commit an actual credential or change an existing encryption key.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional telemetry, disabled by default.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=jobsync
# OTEL_CAPTURE_CONTENT=false
